# Copy to /etc/fingerfood-app.env on Lenovo (chmod 600, root:root).
# CORE_OFFICE_API_TOKEN must match OFFICE_API_TOKEN in /etc/catering/office-api.env.
#
# Production frontend uses same-origin /api through the FastAPI listener.
# Build artifacts are deployed here; this path is never exposed as source code.
FINGERFOOD_FRONTEND_DIST=/home/viktor/fingerfood-runtime/frontend-dist
# See infra/systemd/BFF_ACCESS_BOUNDARY.md — do not expose 8091 on LAN.

CORE_OFFICE_API_URL=http://100.109.6.74:8084
CORE_OFFICE_API_TOKEN=
FINGERFOOD_API_TOKEN=
CATALOG_ADAPTER_STRICT=1

# Optional — defaults include localhost Vite dev ports:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
